ce":["quimica.materia-y-energia","quimica.liquidos-y-solidos"],"ejemplo":"Hielo flotando en agua: una sola sustancia, dos fases."},{"termino":"cambio físico","def":"Transformación en la que las partículas siguen siendo las mismas: cambian de orden, de lugar o de estado.","formas":["cambios físicos","cambio físico"],"en":"quimica.materia-y-energia","enNombre":"Materia y energía","aparece":["quimica.materia-y-energia","quimica.reacciones-y-balance"],"ejemplo":"Fundir hielo: antes y después hay moléculas de H₂O.","ver":["cambio químico"]},{"termino":"cambio químico","def":"Transformación en la que aparecen sustancias nuevas, armadas con los mismos átomos reordenados.","formas":["cambios químicos","cambio químico"],"en":"quimica.materia-y-energia","enNombre":"Materia y energía","aparece":["quimica.materia-y-energia"],"ejemplo":"El hierro que se oxida forma óxido de hierro.","ver":["cambio físico","cambio nuclear"]},{"termino":"cambio nuclear","def":"Transformación del núcleo de los átomos: el elemento pasa a ser otro y se libera mucha energía.","formas":["procesos nucleares","cambios nucleares","proceso nuclear","cambio nuclear"],"en":"quimica.materia-y-energia","enNombre":"Materia y energía","aparece":["quimica.materia-y-energia"],"ejemplo":"El radio-226 emite una partícula alfa y queda radón-222.","ver":["cambio químico"]},{"termino":"energía","def":"Lo que permite calentar, mover o transformar algo. Se mide en joules.","formas":["energías","energía"],"en":"quimica.materia-y-energia","enNombre":"Materia y energía","aparece":["quimica.materia-y-energia","quimica.estructura-atomica","quimica.tabla-periodica","quimica.gases","quimica.cinetica-quimica","quimica.electroquimica","quimica.biomoleculas-y-productos-naturales","quimica.recursos-naturales"],"simbolo":"E","medida":"J","ver":["calor sensible","calor latente"]},{"termino":"calor sensible","def":"Calor que sube o baja la temperatura de un cuerpo sin cambiarle el estado.","formas":["calor sensible"],"en":"quimica.materia-y-energia","enNombre":"Materia y energía","aparece":["quimica.materia-y-energia"],"ejemplo":"Calentar 10 g de agua 20 °C: 10 · 4,18 · 20 = 836 J.","ver":["calor específico","calor latente"]},{"termino":"calor latente","def":"Calor que cambia el estado de un gramo sin cambiar su temperatura.","formas":["calor latente"],"en":"quimica.materia-y-energia","enNombre":"Materia y energía","aparece":["quimica.materia-y-energia"],"simbolo":"L","medida":"J/g","ejemplo":"Fundir 10 g de hielo a 0 °C: 10 · 334 = 3340 J.","ver":["calor sensible","fase"]},{"termino":"calor específico","def":"Calor que necesita un gramo de una sustancia para subir 1 °C.","formas":["calor específico"],"en":"quimica.materia-y-energia","enNombre":"Materia y energía","aparece":["quimica.materia-y-energia"],"simbolo":"c","medida":"J/(g·°C)","ejemplo":"Agua líquida: 4,18 J/(g·°C); hielo: 2,1 J/(g·°C).","ver":["calor sensible"]}]}
