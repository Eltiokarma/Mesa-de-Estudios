  "casos": [
    {"nombre": "Predicción del paso 1: Rosita vende 50 cajas y El Sol 40, con el eje desde 35. Se ven 15 contra 5 (el triple), pero 50/40 = 5/4 = 1,25 veces", "fn": "razonBarras", "args": [{"a": 50, "b": 40, "inicio": 35}], "espera": {"razon": 1.25, "exacto": "5/4", "diferencia": 10, "porcentajeMas": 25, "altoA": 15, "altoB": 5, "dibujada": 3, "errores": {"alturas": 3, "invertida": 0.8, "sobranteDibujado": 2}, "coinciden": []}, "tambien": [{"args": [{"a": 50, "b": 40, "inicio": 0}], "espera": {"razon": 1.25, "dibujada": 1.25, "errores": {"invertida": 0.8, "sobranteDibujado": 0.25}, "coinciden": ["alturas"]}}, {"args": [{"a": 60, "b": 48, "inicio": 40}], "espera": {"razon": 1.25, "dibujada": 2.5, "porcentajeMas": 25, "errores": {"alturas": 2.5, "invertida": 0.8, "sobranteDibujado": 1.5}}}]},
    {"nombre": "Alturas de las barras: con el eje de 35 a 55, 50 llena 3/4 y 40 solo 1/4; con el eje de 0 a 50, 50 llena todo y 40 los 4/5", "fn": "barras", "args": [{"valores": [50, 40], "inicio": 35, "tope": 55}], "espera": {"inicio": 35, "tope": 55, "barras": [{"valor": 50, "alto": 0.75}, {"valor": 40, "alto": 0.25}]}, "tambien": [{"args": [{"valores": [50, 40]}], "espera": {"inicio": 0, "tope": 50, "barras": [{"valor": 50, "alto": 1}, {"valor": 40, "alto": 0.8}]}}]},
    {"nombre": "Predicción del paso 3: gaseosas de la bodega de noviembre a marzo (100, 120, 70, 40, 50). Crece más en porcentaje de febrero a marzo (+10 sobre 40 = 25 %); el tramo más empinado es nov–dic (+20 = 20 %); sobre el valor final, feb–mar daría 20 %; el punto más alto es diciembre", "fn": "crecimientos", "args": [{"valores": [100, 120, 70, 40, 50]}], "espera": {"mayor": 3, "porcentaje": 25, "cambio": 10, "exacto": "25", "tramos.0.cambio": 20, "tramos.0.porcentaje": 20, "tramos.1.cambio": -50, "tramos.3.porcentajeFinal": 20, "errores": {"masEmpinado": {"tramo": 0, "cambio": 20, "porcentaje": 20}, "baseFinal": {"tramo": 3, "porcentaje": 20}, "puntoMasAlto": {"indice": 1, "valor": 120}}, "coinciden": []}},
    {"nombre": "Una serie en que el tramo más empinado sí es el de mayor porcentaje: 40, 50, 80, 90 (de 50 a 80 sube 30 = 60 %; de 80 a 90 sube 10 = 12,5 %)", "fn": "crecimientos", "args": [{"valores": [40, 50, 80, 90]}], "espera": {"mayor": 1, "porcentaje": 60, "cambio": 30, "tramos.0.porcentaje": 25, "tramos.2.porcentaje": 12.5, "errores": {"baseFinal": {"tramo": 1, "porcentaje": 37.5}, "puntoMasAlto": {"indice": 3, "valor": 90}}, "coinciden": ["masEmpinado"]}},
    {"nombre": "Mismo aumento, distinto porcentaje: de 40 a 50 es 25 % y de 80 a 90 es 12,5 %; los dos suben 10 y el segundo llega más alto", "fn": "dosCrecimientos", "args": [{"uno": [40, 50], "otro": [80, 90]}], "espera": {"porcentajes": [25, 12.5], "cambios": [10, 10], "mayor": "uno", "errores": {"absoluta": "iguales", "llegaMasAlto": "otro"}, "coinciden": ["baseFinal"]}},
    {"nombre": "Deporte favorito de 200 alumnos (fútbol 80, vóley 50, básquet 40, ajedrez 30): 144°, 90°, 72° y 54°; 40 %, 25 %, 20 % y 15 %", "fn": "sectores", "args": [{"cantidades": [80, 50, 40, 30]}], "espera": {"total": 200, "sectores": [{"cantidad": 80, "fraccion": "2/5", "porcentaje": 40, "grados": 144}, {"cantidad": 50, "fraccion": "1/4", "porcentaje": 25, "grados": 90}, {"cantidad": 40, "fraccion": "1/5", "porcentaje": 20, "grados": 72}, {"cantidad": 30, "fraccion": "3/20", "porcentaje": 15, "grados": 54}], "sumaPorcentajes": 100, "sumaGrados": 360}},
    {"nombre": "Predicción del paso 4: de 200 alumnos, el sector de básquet mide 72°: 72/360 = 1/5, o sea 40 alumnos (20 %). Con la vuelta de 100 saldrían 144; los grados como alumnos, 72; el porcentaje como alumnos, 20", "fn": "cantidadDeSector", "args": [{"total": 200, "grados": 72}], "espera": {"cantidad": 40, "porcentaje": 20, "fraccion": "1/5", "errores": {"sobre100": 144, "gradosComoCantidad": 72, "porcentajeComoCantidad": 20}, "coinciden": []}, "tambien": [{"args": [{"total": 240, "grados": 108}], "espera": {"cantidad": 72, "porcentaje": 30, "fraccion": "3/10", "errores": {"sobre100": 259.2, "gradosComoCantidad": 108, "porcentajeComoCantidad": 30}}}]},
