      "tambien": [ { "args": [{ "fn": "cos", "g": 45 }], "espera": { "texto": "1/2", "errores.doble.texto": "√2", "coinciden": [] } } ] },

    { "nombre": "sen 75° = sen(45° + 30°) (predicción del paso 4): (√6 + √2)/4 ≈ 0,966; TR16 sen 45° + sen 30° = (√2 + 1)/2 ≈ 1,207; ID4 con − (√6 − √2)/4; ID6 sen 45° · sen 30° = √2/4",
