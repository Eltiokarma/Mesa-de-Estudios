      "espera": { "formula": "Ca3(PO4)2", "atomos.Ca": 3, "atomos.P": 2, "atomos.O": 8 },
      "tambien": [ { "args": ["Fe^3+", "Cl^-"], "espera": { "formula": "FeCl3", "nCation": 1, "nAnion": 3 } } ] },

