      "espera": { "formula": "H3PO4", "forma": "orto", "agua": 3, "reaccion": "P2O5 + 3H2O -> 2H3PO4", "nombres.tradicional": "ácido fosfórico" },
      "tambien": [ { "args": ["oxacido", "P", 5, { "forma": "meta" }], "espera": { "formula": "HPO3", "nombres.tradicional": "ácido metafosfórico" } },
                   { "args": ["oxacido", "P", 5, { "forma": "piro" }], "espera": { "formula": "H4P2O7", "nombres.tradicional": "ácido pirofosfórico" } } ] },

    { "nombre": "El árbol del metal: 4Fe + 3O2 → 2Fe2O3; Fe2O3 + 3H2O → 2Fe(OH)3; CaO + H2O → Ca(OH)2 (informe). Error del hidróxido: sin paréntesis (FeOH3)",
