      "verificar": [ { "fn": "termino", "args": [{ "A": { "c": 3, "v": { "a": 1 } }, "B": { "c": 1, "v": { "b": 1 } }, "n": 6, "lugar": 3 }], "espera": { "texto": "1215a⁴b²" } } ],
