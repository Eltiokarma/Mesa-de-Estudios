      "id": "p1",
      "nivel": "básico",
      "enunciado": "Si P(x) = 4x³ − x² + 2x − 9, calcula P(0), P(1) y P(−1).",
      "respuesta": "P(0) = −9, P(1) = −4 y P(−1) = −16.",
      "pasos": [
        "P(0): todos los términos con x se anulan; queda el término independiente, −9.",
        "P(1): cada potencia de 1 vale 1, así que queda la suma de coeficientes: 4 − 1 + 2 − 9 = −4.",
        "P(−1): (−1)³ = −1 y (−1)² = 1 (la potencia par de un negativo es positiva): 4(−1) − 1 + 2(−1) − 9 = −16."
      ],
      "verificar": [ { "fn": "pDeCero", "args": [{ "coefs": [4, -1, 2, -9] }], "espera": { "valor": -9 } },
                     { "fn": "pDeUno", "args": [{ "coefs": [4, -1, 2, -9] }], "espera": { "valor": -4 } },
                     { "fn": "evaluar", "args": [{ "coefs": [4, -1, 2, -9], "x": -1 }], "espera": { "valor": -16 } } ],
