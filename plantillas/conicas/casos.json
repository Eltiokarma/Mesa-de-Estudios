        "pendiente.errores.invertidaSinRaiz.texto": "±9/4", "asintotas": "y − 1 = ±(2/3)(x + 2)", "focosTexto": "(−2; 1 + √13) y (−2; 1 − √13)", "verticesTexto": "(−2; 3) y (−2; −1)",
