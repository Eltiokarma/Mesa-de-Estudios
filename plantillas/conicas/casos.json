      "tambien": [ { "args": [{ "nx": 169, "ny": 144 }], "espera": { "c.texto": "5", "e.texto": "5/13", "LR.texto": "288/13", "focosTexto": "(±5; 0)" } } ] },

    { "nombre": "Parábola que abre a la izquierda (paso 5): (y − 1)² = −8(x − 2) → p = −2, F(0; 1), directriz x = 4; CO11 (4; 1); CO12 (−6; 1); CO13 (2; −1)",
      "fn": "parabola", "args": [{ "eje": "x", "h": 2, "k": 1, "cuatroP": -8 }],
      "espera": { "p": -2, "pTexto": "−2", "verticeTexto": "(2; 1)", "focoTexto": "(0; 1)", "directriz": "x = 4", "abre": "a la izquierda", "ecuacion": "(y − 1)² = −8(x − 2)",
        "foco.errores.signo.texto": "(4; 1)", "foco.errores.cuatroP.texto": "(−6; 1)", "foco.errores.eje.texto": "(2; −1)", "num.F": [0, 1] } },

    { "nombre": "Lado recto de la misma parábola (paso 6): LR = 4|p| = 8, extremos (0; 5) y (0; −3); CO14 −8; CO15 4; CO16 2",
      "fn": "parabola", "args": [{ "eje": "x", "h": 2, "k": 1, "p": -2 }],
      "espera": { "LR": 8, "lr.texto": "8", "lr.errores.conSigno.texto": "−8", "lr.errores.dosP.texto": "4", "lr.errores.soloP.texto": "2", "lr.coinciden": [], "extremosLR": "(0; 5) y (0; −3)" } },

    { "nombre": "Parábolas con p positivo y fraccionario: x² = 6y (p = 3/2, F(0; 3/2), y = −3/2, LR 6; CO14 coincide); y² = 4(x + 3) (V(−3; 0), F(−2; 0), x = −4)",
      "fn": "parabola", "args": [{ "eje": "y", "h": 0, "k": 0, "p": "3/2" }],
      "espera": { "ecuacion": "x² = 6y", "focoTexto": "(0; 3/2)", "directriz": "y = −3/2", "abre": "hacia arriba", "lr.texto": "6", "lr.coinciden": ["conSigno"], "extremosLR": "(−3; 3/2) y (3; 3/2)" },
      "tambien": [ { "args": [{ "eje": "x", "h": -3, "k": 0, "p": 1 }], "espera": { "ecuacion": "y² = 4(x + 3)", "focoTexto": "(−2; 0)", "directriz": "x = −4", "abre": "a la derecha", "lr.texto": "4", "lr.errores.soloP.texto": "1" } },
                   { "args": [{ "eje": "y", "h": 1, "k": -2, "cuatroP": -1 }], "espera": { "ecuacion": "(x − 1)² = −(y + 2)", "focoTexto": "(1; −9/4)", "directriz": "y = −7/4", "abre": "hacia abajo", "lr.texto": "1" } } ] },

    { "nombre": "Hipérbola horizontal (paso 7): x²/9 − y²/16 = 1 → c = 5, focos (±5; 0); CO2 (±√7; 0); CO17 a² = 16 lleva el eje a y: (0; ±5); CO18 (±3; 0)",
      "fn": "hiperbola", "args": [{ "a2": 9, "b2": 16, "eje": "x" }],
      "espera": { "ecuacion": "x²/9 − y²/16 = 1", "c.texto": "5", "focos.texto": "(±5; 0)", "focos.errores.cElipse.texto": "(±√7; 0)", "focos.errores.aMayor.texto": "(0; ±5)",
        "focos.errores.vertices.texto": "(±3; 0)", "verticesTexto": "(±3; 0)", "asintotas": "y = ±(4/3)x", "LR.texto": "32/3" } },

    { "nombre": "Asíntotas y excentricidad de la misma hipérbola: ±4/3; CO21 ±3/4; CO22 ±16/9; CO23 ±9/16; e = 5/3 > 1; CO5 3/5; CO24 10/3",
      "fn": "hiperbola", "args": [{ "a2": 9, "b2": 16 }],
