      "fn": "arco", "args": [{ "fn": "sen", "k": "-1/2" }],
      "espera": { "existe": true, "valor": -0.5235987755982988, "texto": "−π/6", "textoG": "−30°", "angulo.grados": -30, "rango": "[−π/2; π/2]", "dominio": "[−1; 1]",
        "errores.fueraDelRango.texto": "7π/6", "errores.vueltaPositiva.texto": "11π/6", "errores.sinSigno.texto": "π/6", "errores.comoCoseno.texto": "2π/3", "coinciden": [] } },

    { "nombre": "arcsen de los notables: arcsen 1 = π/2 (IN1 coincide), arcsen 0 = 0, arcsen(√3/2) = π/3, arcsen(−√2/2) = −π/4",
