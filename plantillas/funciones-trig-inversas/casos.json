      "espera": { "texto": "π/2", "valor": 1.5707963267948966, "coinciden": ["fueraDelRango", "vueltaPositiva", "sinSigno"], "errores.comoCoseno.texto": "0" },
      "tambien": [ { "args": [{ "fn": "sen", "k": "0" }], "espera": { "texto": "0", "valor": 0, "errores.fueraDelRango.texto": "π" } },
