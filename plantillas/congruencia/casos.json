{
  "plantilla": "congruencia",
  "unidades": "Longitudes en las unidades del problema; ángulos en grados. 37° y 53° son los ángulos de academia del triángulo 3-4-5 (sen 37° = 3/5). El lado a es BC (opuesto a A), b es CA y c es AB. Puntos como [x, y].",
  "convencion": "Cada caso llama a la función 'fn' de motor.js con 'args' y compara 'espera'. Los campos anidados van con punto (triangulos.0.lados.c); las listas se comparan completas; los textos se comparan exactos. 'cuantos' es 'ninguno', 'uno', 'dos' o 'infinitos' (triángulos no congruentes que cumplen los datos). En construir, A queda en (0; 0), B en (c; 0) y C arriba.",
  "verificacion": "",
  "tolerancia": 1e-9,
  "casos": [
    { "nombre": "LLL con varillas 7, 8 y 5: un solo triángulo (el reflejo es congruente); el ángulo entre 8 y 5 mide 60° y C queda en (4; 4√3)",
      "fn": "construir", "args": [{ "a": 7, "b": 8, "c": 5 }],
      "espera": { "criterio": "LLL", "cuantos": "uno", "determina": true, "triangulos.0.academia.A": 60, "triangulos.0.angulos.B": 81.78678929826181,
                  "triangulos.0.vertices.C": [4, 6.928203230275509], "errores.reflejoComoOtro": "dos", "errores.ordenDeUnion": "seis", "errores.bisagrasLibres": "infinitos" } },

    { "nombre": "LLL que no cierra: 3 + 4 no llega a 8 (desigualdad triangular); tampoco 3, 4 y 7 (quedan alineados)",
      "fn": "construir", "args": [{ "a": 3, "b": 4, "c": 8 }],
      "espera": { "criterio": "LLL", "cuantos": "ninguno", "determina": false, "triangulos": [], "errores.comoSiCerrara": "uno" },
      "tambien": [ { "args": [{ "a": 3, "b": 4, "c": 7 }], "espera": { "cuantos": "ninguno" } } ] },

    { "nombre": "LAL: b = 8, c = 5 y el ángulo de 60° entre ellos → el tercer lado mide 7 (el mismo triángulo que con LLL)",
      "fn": "construir", "args": [{ "b": 8, "A": 60, "c": 5 }],
      "espera": { "criterio": "LAL", "cuantos": "uno", "triangulos.0.lados.a": 7, "errores.reflejoComoOtro": "dos" } },

    { "nombre": "ALA: ∠A = 60°, AB = 8, ∠B = 45° → ∠C = 75°, b = 8(√3 − 1) y a = 4(3√2 − √6)",
      "fn": "construir", "args": [{ "A": 60, "c": 8, "B": 45 }],
      "espera": { "criterio": "ALA", "cuantos": "uno", "triangulos.0.academia.C": 75, "triangulos.0.lados.b": 5.8564064605510175,
                  "triangulos.0.lados.a": 7.172603777344431, "triangulos.0.lados.c": 8 } },

    { "nombre": "LAA: ∠A = 50°, ∠B = 60° y BC = 9 (opuesto a A): la suma da ∠C = 70° y se vuelve ALA; un solo triángulo",
      "fn": "construir", "args": [{ "A": 50, "B": 60, "a": 9 }],
      "espera": { "criterio": "LAA", "cuantos": "uno", "anguloQueFalta": 70, "triangulos.0.lados.b": 10.174642873624224,
                  "triangulos.0.lados.c": 11.040134372151096, "errores.soloConLadoEntre": "infinitos" } },

    { "nombre": "Ángulos que suman 180° o más no cierran: ∠A = 100° y ∠B = 80° con AB = 5",
      "fn": "construir", "args": [{ "A": 100, "c": 5, "B": 80 }],
      "espera": { "criterio": "ALA", "cuantos": "ninguno", "errores.comoSiCerrara": "uno" } },

    { "nombre": "Trampa LLA: ∠A = 37°, AC = 10 y BC = 6,5. La altura desde C es 6; el compás corta la base en AB = 8 ∓ 2,5: dos triángulos no congruentes (5,5 y 10,5)",
      "fn": "construir", "args": [{ "A": 37, "b": 10, "a": 6.5 }],
      "espera": { "criterio": "LLA", "cuantos": "dos", "determina": false, "altura": 6, "terceros": [5.5, 10.5], "frenteAlMayor": false,
                  "errores.comoCriterio": "uno", "errores.ladoCortoNoCierra": "ninguno", "triangulos.0.lados.c": 5.5, "triangulos.1.lados.c": 10.5 },
      "tambien": [
        { "fn": "mover", "args": [{ "A": 37, "b": 10, "a": 6.5 }, [5.4, 0.2]], "espera": { "cierra": true, "indice": 0, "punto": [5.5, 0], "lados.c": 5.5 } },
        { "fn": "mover", "args": [{ "A": 37, "b": 10, "a": 6.5 }, [8, 13]], "espera": { "cierra": false, "punto": [8, 12.5], "falta": 12.5 } }
      ] },

    { "nombre": "LLA tangente: con BC = 6, igual a la altura, el compás apenas toca la base: un triángulo, rectángulo en B, con AB = 8 (el 6-8-10)",
      "fn": "construir", "args": [{ "A": 37, "b": 10, "a": 6 }],
      "espera": { "cuantos": "uno", "motivo": "tangente", "terceros": [8], "triangulos.0.academia.B": 90, "triangulos.0.academia.C": 53, "errores.nuncaDetermina": "dos" } },

    { "nombre": "LLA que no alcanza: BC = 5 es menor que la altura 6, ningún triángulo",
      "fn": "construir", "args": [{ "A": 37, "b": 10, "a": 5 }],
      "espera": { "cuantos": "ninguno", "terceros": [], "errores.comoCriterio": "uno" } },

    { "nombre": "LLA con el ángulo frente al lado mayor: BC = 12 > AC = 10; el otro corte cae detrás de A, en 8 − √108; un solo triángulo con AB = 8 + √108",
      "fn": "construir", "args": [{ "A": 37, "b": 10, "a": 12 }],
      "espera": { "cuantos": "uno", "determina": true, "frenteAlMayor": true, "terceros": [18.392304845413264], "detras": [-2.392304845413264], "errores.nuncaDetermina": "dos" },
      "tambien": [ { "args": [{ "A": 37, "b": 10, "a": 10 }], "espera": { "cuantos": "uno", "terceros": [16] } } ] },

    { "nombre": "Hipotenusa y cateto: ∠A = 90°, cateto AC = 6, hipotenusa BC = 10 → AB = 8 (el corte de atrás, −8, es el reflejo); GE11 sumando: √136",
      "fn": "construir", "args": [{ "A": 90, "b": 6, "a": 10 }],
      "espera": { "criterio": "LLA", "cuantos": "uno", "recto": true, "terceros": [8], "detras": [-8], "errores.pitagorasSuma": 11.661903789690601, "triangulos.0.academia.B": 37 } },

    { "nombre": "LLA con ángulo obtuso, frente al lado mayor: ∠A = 120°, AC = 5, BC = 7 → AB = 3, uno solo; al revés (AC = 7, BC = 5) no hay ninguno",
      "fn": "construir", "args": [{ "A": 120, "b": 5, "a": 7 }],
      "espera": { "cuantos": "uno", "terceros": [3], "frenteAlMayor": true },
      "tambien": [ { "args": [{ "A": 120, "b": 7, "a": 5 }], "espera": { "cuantos": "ninguno", "terceros": [] } } ] },

    { "nombre": "AAA: 37°, 53° y 90° no determinan el tamaño (infinitos, todos semejantes); 40°, 60° y 90° no suman 180° y no cierran",
      "fn": "construir", "args": [{ "A": 37, "B": 53, "C": 90 }],
      "espera": { "criterio": "AAA", "cuantos": "infinitos", "determina": false, "triangulos": [], "errores.comoCriterio": "uno", "errores.sinTriangulo": "ninguno" },
      "tambien": [ { "args": [{ "A": 40, "B": 60, "C": 90 }], "espera": { "cuantos": "ninguno" } },
                   { "fn": "mover", "args": [{ "A": 37, "B": 53, "C": 90 }, [5, 3]], "espera": { "cierra": true, "lados.a": 3, "lados.b": 4, "lados.c": 5 } },
                   { "fn": "mover", "args": [{ "A": 37, "B": 53, "C": 90 }, [10, -1]], "espera": { "cierra": true, "lados.a": 6, "lados.b": 8 } } ] },

    { "nombre": "Correspondencia: ABC con AB = 5, BC = 7, CA = 8 y PQR con PQ = 8, QR = 5, RP = 7 → ΔABC ≅ ΔQRP (no ΔPQR por el orden de escritura, ni ΔPRQ por la posición en el dibujo); PQR está volteado",
      "fn": "correspondencia", "args": [ { "nombres": "ABC", "lados": [5, 7, 8], "puntos": [[0, 0], [5, 0], [4, 6.928203230275509]] },
                                         { "nombres": "PQR", "lados": [8, 5, 7], "puntos": [[0, 0], [6.285714285714286, 4.948716593053935], [7, 0]] } ],
      "espera": { "congruentes": true, "texto": "ΔABC ≅ ΔQRP", "pares.A": "Q", "pares.B": "R", "pares.C": "P", "todas": ["ΔABC ≅ ΔQRP"],
                  "errores.ordenEscritura": "ΔABC ≅ ΔPQR", "errores.porPosicion": "ΔABC ≅ ΔPRQ", "errores.volteadoNoCongruente": "no congruentes" },
      "tambien": [ { "args": [ { "nombres": "ABC", "lados": [5, 5, 6] }, { "nombres": "DEF", "lados": [5, 5, 6] } ],
                     "espera": { "texto": "ΔABC ≅ ΔDEF", "todas": ["ΔABC ≅ ΔDEF", "ΔABC ≅ ΔFED"], "errores.ordenEscritura": null } },
                   { "args": [ { "nombres": "ABC", "lados": [5, 6, 7] }, { "nombres": "DEF", "lados": [5, 6, 8] } ], "espera": { "congruentes": false, "texto": null } } ] },

    { "nombre": "Mediatriz: A(−5; 0), B(5; 0) y P a 12 del punto medio → PA = PB = 13 (5-12-13); errores: 12, 17 y √119",
