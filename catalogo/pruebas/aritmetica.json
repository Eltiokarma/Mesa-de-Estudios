    "suma-descuentos": {
      "respaldo": "documentado",
      "describe": "Suma los porcentajes sucesivos (AR1)"
    },
    "monto-descuento": {
      "respaldo": "hipotesis",
      "describe": "Responde cuánto se descontó y no cuánto se paga (AR5)"
    },
    "un-solo-descuento": {
      "respaldo": "hipotesis",
      "describe": "Aplica uno solo de los descuentos"
    },
    "se-compensan": {
      "respaldo": "documentado",
      "describe": "Cree que subir y bajar se compensan, como si se restaran (AR1, AR2)"
    },
    "solo-aumento": {
      "respaldo": "hipotesis",
      "describe": "Aplica solo el aumento (o un solo periodo)"
    },
    "monto-variacion": {
      "respaldo": "hipotesis",
      "describe": "Responde cuánto cambió y no lo que se pregunta (AR5)"
    },
    "producto": {
      "respaldo": "parcial",
      "describe": "Multiplica los porcentajes entre sí (AR4)"
    },
    "lo-que-queda": {
      "respaldo": "parcial",
      "describe": "Confunde el factor con el porcentaje: lo que queda con lo que cambia (AR4)"
    },
    "AR3": {
      "respaldo": "parcial",
      "describe": "Calcula el porcentaje sobre la base equivocada (el valor nuevo en vez del de antes, o al revés)"
    },
    "AR16": {
      "respaldo": "documentado",
      "describe": "Calcula el interés compuesto como simple"
    }
  },
