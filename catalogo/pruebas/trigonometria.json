  "errores": {
    "TR1-lee-2-como-2pi": {
      "respaldo": "parcial",
      "describe": "Lee un ángulo en radianes sin π como si tuviera π"
    },
    "TR3-radian-como-grado": {
      "respaldo": "parcial",
      "describe": "Cree que un radián es un grado"
    },
    "factor-invertido": {
      "respaldo": "hipotesis",
      "describe": "Multiplica por π/180 en vez de 180/π"
    },
    "TR4-arco-con-grados": {
      "respaldo": "hipotesis",
      "describe": "Multiplica el radio por el ángulo en grados"
    },
    "TR2-arco-igual-radio": {
      "respaldo": "hipotesis",
      "describe": "Cree que el arco mide lo mismo que el radio"
    },
    "arco-sin-radio": {
      "respaldo": "hipotesis",
      "describe": "Da el ángulo en radianes como si fuera la longitud del arco"
    },
    "TR11-TR12-abscisa-sin-signo": {
      "respaldo": "parcial",
      "describe": "Toma el coseno como una distancia, sin el signo del cuadrante"
    },
    "TR14-cambia-de-razon": {
      "respaldo": "hipotesis",
      "describe": "Cambia a la co-razón al reducir con 180°"
    },
    "TR11-cruza-seno-coseno": {
      "respaldo": "parcial",
      "describe": "Confunde el seno con el coseno (la ordenada con la abscisa)"
    },
    "TR18-periodo-por-B": {
      "respaldo": "hipotesis",
      "describe": "Multiplica 360° por B en vez de dividir"
    },
    "TR18-periodo-igual-B": {
      "respaldo": "hipotesis",
      "describe": "Toma como periodo el número que acompaña a x"
    },
    "periodo-con-amplitud": {
      "respaldo": "hipotesis",
      "describe": "Mezcla la amplitud con el periodo"
    },
    "TR23-solo-calculadora": {
      "respaldo": "hipotesis",
      "describe": "Se queda con el ángulo agudo que da la calculadora y olvida el obtuso"
    },
    "a-menor-que-b-no-alcanza": {
      "respaldo": "hipotesis",
      "describe": "Cree que si a es menor que b el lado no alcanza a cerrar el triángulo"
    },
    "TR24-signo": {
      "respaldo": "hipotesis",
      "describe": "Suma el término 2bc·cos A en vez de restarlo"
    },
    "TR24-sin-termino": {
      "respaldo": "hipotesis",
      "describe": "Olvida el término 2bc·cos A (usa Pitágoras)"
    },
    "suma-de-lados": {
      "respaldo": "hipotesis",
      "describe": "Suma los dos lados"
    },
    "ID8-olvida-el-dos": {
      "respaldo": "hipotesis",
      "describe": "Usa 1 − sen²x: olvida el 2 de cos 2x = 1 − 2 sen²x"
    },
    "ID15-olvida-el-cuadrado": {
      "respaldo": "hipotesis",
      "describe": "Usa 1 − 2 sen x: olvida elevar al cuadrado"
    },
    "ID7-cos-doble-como-pitagorica": {
      "respaldo": "hipotesis",
      "describe": "Confunde cos 2x con cos²x + sen²x = 1"
    },
    "TR16-tangente-de-la-suma-lineal": {
      "respaldo": "hipotesis",
      "describe": "Reparte la tangente: tan(a + b) = tan a + tan b"
    },
    "ID11-signo-del-denominador": {
      "respaldo": "hipotesis",
      "describe": "Suma en el denominador: 1 + tan a · tan b"
    },
    "ID6-producto-de-tangentes": {
      "respaldo": "hipotesis",
      "describe": "Multiplica las tangentes"
    },
    "IN3-se-cancelan-siempre": {
      "respaldo": "hipotesis",
      "describe": "Cree que arcsen(sen θ) = θ siempre, sin mirar el rango"
    },
    "TR14-cambia-de-funcion": {
      "respaldo": "hipotesis",
      "describe": "Al reducir cambia de función: sen(180° − x) = cos x"
    },
    "IN24-signo-al-reducir": {
      "respaldo": "hipotesis",
      "describe": "Al reducir pone un signo que no va: sen(180° − x) = −sen x"
    },
    "IN8-cancela-funciones-distintas": {
      "respaldo": "hipotesis",
      "describe": "Cancela funciones distintas: sen(arctan k) = k"
    },
    "IN9-olvida-la-raiz": {
      "respaldo": "hipotesis",
      "describe": "Olvida sacar la raíz del lado que sale con Pitágoras"
    },
    "IN10-usa-la-reciproca": {
      "respaldo": "hipotesis",
      "describe": "Usa la recíproca (hipotenusa entre cateto)"
    }
  },
